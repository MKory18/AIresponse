# ═══════════════ Core ═══════════════
# Public base URL of the deployment (used by OAuth redirects, logout, etc.)
APP_URL=http://localhost:3000
NODE_ENV=development

# ═══════════════ Database ═══════════════
# Staging PostgreSQL — NEVER point this at the Odoo database.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_commerce?schema=public

# ═══════════════ Security ═══════════════
# Session signing secret (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Encryption key for channel credentials at rest (min 32 chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ═══════════════ Queue / Worker ═══════════════
# Durable DB-backed jobs (no Redis required by current architecture).
REDIS_URL=
WORKER_POLL_INTERVAL_MS=5000
# Shared secret for POST /api/jobs/run (leave empty to allow local runs only)
JOBS_SECRET=

# ═══════════════ Storage ═══════════════
STORAGE_PROVIDER=local
# Persistent volume path for LocalStorageProvider uploads
STORAGE_DIR=/app/.data/storage

# ═══════════════ Observability ═══════════════
LOG_LEVEL=info

# ═══════════════ AI Providers ═══════════════
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# ── Hermes Agent (OpenAI-compatible gateway) ──
# Hermes exposes POST {HERMES_BASE_URL}/v1/chat/completions with a Bearer key.
# Example local gateway: HERMES_BASE_URL=http://127.0.0.1:8642/v1
# API_SERVER_KEY from ~/.hermes/.env goes in HERMES_API_KEY.
# HERMES_MODEL defaults to "hermes-agent".
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Allow workspace-configured Hermes endpoints on loopback/LAN (self-hosted
# gateway, e.g. http://127.0.0.1:8642). "1"/"true"/"yes" enables. Cloud
# metadata and reserved ranges stay blocked regardless. Keep the gateway
# port bound to localhost/LAN — never expose 8642 publicly.
#HERMES_ALLOW_PRIVATE_NETWORK=true
# Model routing (optional overrides)
CLASSIFICATION_MODEL=
EXTRACTION_MODEL=
RESPONSE_MODEL=
VISION_MODEL=
SUMMARY_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# ═══════════════ Meta (Facebook Messenger) ═══════════════
META_APP_ID=
META_APP_SECRET=
# Public redirect URI for OAuth (defaults to APP_URL + /api/channels/facebook/callback)
META_REDIRECT_URI=
# Token typed into the Meta App webhook configuration UI
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version (default v21.0)
META_GRAPH_VERSION=

# ═══════════════ Other channels (not part of staging scope) ═══════════════
WHATSAPP_TOKEN=
TELEGRAM_BOT_TOKEN=
