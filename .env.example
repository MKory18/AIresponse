# ═══════════════ Core ═══════════════
# Public base URL of the deployment (used by OAuth redirects, logout, etc.)
APP_URL=http://localhost:3000
NODE_ENV=development

# ═══════════════ Database ═══════════════
# Staging PostgreSQL — NEVER point this at the Odoo database.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_commerce?schema=public

# ═══════════════ Security ═══════════════
# Session signing secret (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Encryption key for channel credentials at rest (min 32 chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ═══════════════ Queue / Worker ═══════════════
# Durable DB-backed jobs (no Redis required by current architecture).
REDIS_URL=
WORKER_POLL_INTERVAL_MS=5000
# Shared secret for POST /api/jobs/run (leave empty to allow local runs only)
JOBS_SECRET=

# ═══════════════ Storage ═══════════════
STORAGE_PROVIDER=local
# Persistent volume path for LocalStorageProvider uploads
STORAGE_DIR=/app/.data/storage

# ═══════════════ Observability ═══════════════
LOG_LEVEL=info

# ═══════════════ AI Providers ═══════════════
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Model routing (optional overrides)
CLASSIFICATION_MODEL=
EXTRACTION_MODEL=
RESPONSE_MODEL=
VISION_MODEL=
SUMMARY_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# ═══════════════ Meta (Facebook Messenger) ═══════════════
META_APP_ID=
META_APP_SECRET=
# Public redirect URI for OAuth (defaults to APP_URL + /api/channels/facebook/callback)
META_REDIRECT_URI=
# Token typed into the Meta App webhook configuration UI
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version (default v21.0)
META_GRAPH_VERSION=

# ═══════════════ Other channels (not part of staging scope) ═══════════════
WHATSAPP_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
# AI_DISABLE_AUTO_HANDOFF=true  # اختياري: إيقاف التحويل التلقائي للموظفين (رد فوري على كل رسالة)

# مدة الاحتفاظ بوسائط الزبون الواردة (صور · مستندات · بصمات صوتية) بالأيام.
# بعد المدة: الملف وصف الوسيط ينحذفوا نهائيًا، والرسالة بتحتفظ بعلامة
# «الوسيط انتهى». افتراضي 180 · `0` = الكنس مطفي والملفات تبقى بلا مدة.
WA_MEDIA_RETENTION_DAYS=180
# مدة الاحتفاظ بحمولة أحداث القنوات الخام بالأيام (أرقام · نصوص · رمز النقرة).
# الحمولة تُفرّغ بعد هالمدة والصف يبقى (عدم تكرار الأحداث معتمد عليه).
# افتراضي 30 · `0` = الكنس مطفي والحمولة تبقى بلا مدة.
WEBHOOK_PAYLOAD_RETENTION_DAYS=30
