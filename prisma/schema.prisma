// ─────────────────────────── P9: Campaigns ───────────────────────────

enum MarketingConsent {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum CampaignStatus {
  DRAFT
  VALIDATING
  READY
  SCHEDULED
  RUNNING
  PAUSED
  CANCELLED
  COMPLETED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  EXCLUDED
  CANCELLED
}

enum CampaignErrorCategory {
  TRANSIENT
  PERMANENT
}

enum CampaignEventType {
  CREATED
  VALIDATED
  CONTENT_APPROVED
  SCHEDULED
  STARTED
  PAUSED
  RESUMED
  CANCELLED
  COMPLETED
  FAILED
  POLICY_BLOCKED
  RECIPIENT_EXCLUDED
  RECIPIENT_SENT
  RECIPIENT_FAILED
}

/// شريحة جمهور — تعريف حتمي بمجموعة مغلقة من الفلاتر (لا SQL ولا كود).
/// الشريحة ديناميكية دائمًا: الأعضاء يُعاد تقييمهم عند كل معاينة/حملة،
/// ولقطة الثابتة للتنفيذ هي صفوف CampaignRecipient لحملة واحدة.
model AudienceSegment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  /// تعريف مضمون السحب من segment-schemas.ts — يُتحقق منه Zod عند كل قراءة.
  definition  Json
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]

  @@index([workspaceId, isActive])
}

model Campaign {
  id              String         @id @default(cuid())
  workspaceId     String
  segmentId       String
  name            String
  description     String?
  channelType     ChannelType
  channelId       String?
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  timezone        String         @default("UTC")
  endsAt          DateTime?
  /// حد إرسال لكل دقيقة (حتمي، يُطبق في كل tick).
  ratePerMinute   Int            @default(30)
  /// نافذة الدقيقة الحالية للحد (كيف لا يعتمد على ذاكرة العامل).
  windowStartAt   DateTime?
  sentInWindow    Int            @default(0)
  /// الإصدار المعتمد المثبّت (لقطة المحتوى).
  contentVersionId String?
  approvedBy      String?
  approvedAt      DateTime?
  /// مفتاح قبول الموافقة: تجزئة الجمهور المتوقع + معرّف الإصدار — إعادة
  /// التحقق عند النشر ترفض إذا تغير الجمهور بعد الموافقة.
  approvalAudienceHash String?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  failReason      String?
  lastTickSeq     Int            @default(0)
  createdBy       String
  /// P12 — مصدر الحملة: manual · clipper · hermes. الحملات القادمة من نظام
  /// آخر تحمل مرجعه ومفتاح عدم التكرار حتى لا تتكرر بإعادة المحاولة.
  source          String         @default("manual")
  externalSystem  String?
  externalRef     String?
  externalIdempotencyKey String?
  /// P12 — نتائج الحملة المبلّغة للنظام صاحبها (مؤقتة ثم نهائية).
  resultsSentAt      DateTime?
  finalResultsSentAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segment        AudienceSegment         @relation(fields: [segmentId], references: [id])
  contentVersions CampaignContentVersion[]
  recipients     CampaignRecipient[]
  events         CampaignEvent[]

  @@unique([workspaceId, externalIdempotencyKey])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, externalSystem, externalRef])
}

/// لقطة محتوى append-only: تعديل المسودة ينشئ إصدارًا جديدًا، والاعتماد
/// يثبّت الإصدار المشار إليه في Campaign.contentVersionId.
model CampaignContentVersion {
  id            String   @id @default(cuid())
  workspaceId   String
  campaignId    String
  version       Int
  text          String
  /// لقناة تفرض قالبًا معتمدًا (WhatsApp): اسم القالب ولغته كما هو مسجّل
  /// في Meta — اعتماد Meta نفسه يتحقق عبر واجهة المالك (BLOCKED محليًا).
  templateName  String?
  templateLanguage String?
  templateVariables Json @default("{}")
  status        String   @default("DRAFT")
  approvedBy    String?
  approvedAt    DateTime?
  createdBy     String
  createdAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([workspaceId, campaignId])
}

/// لقطة المستلمين للحملة — صف لكل عميل مؤهل محسوب لحظة البدء، مع إعادة
/// تحقق كاملة من الأهلية لحظة إرسال كل رسالة (قد تتغير الحالة بعد اللقطة).
model CampaignRecipient {
  id            String                  @id @default(cuid())
  workspaceId   String
  campaignId    String
  customerId    String
  conversationId String?
  status        CampaignRecipientStatus @default(PENDING)
  excludeReason String?
  messageId     String?
  attempts      Int                     @default(0)
  lastError     String?
  errorCategory CampaignErrorCategory?
  sentAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([workspaceId, campaignId, status])
  @@index([campaignId, status, updatedAt])
}

/// سجل أحداث الحملة (تدقيق + قياس) — بلا بيانات شخصية.
model CampaignEvent {
  id          String            @id @default(cuid())
  workspaceId String
  campaignId  String
  type        CampaignEventType
  actorUserId String?
  reason      String?
  count       Int               @default(0)
  payload     Json              @default("{}")
  createdAt   DateTime          @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, campaignId, type])
}

// ─────────────── P12: الربط مع منظومة Zaki وباب الوكلاء ───────────────

/// لمسة إسناد واحدة (إعلان أو رمز كليبر) مسجّلة من بيانات قناة موثوقة
/// (referral من Meta) أو رمز صريح بأول رسالة. «بداية المحادثة بتحكم»:
/// أول لمسة بنافذتها تفتح حلقة (episodeStart) ولا تُستبدل داخلها.
/// المعرّفات الشخصية (ctwa_clid · PSID) مشفّرة ولا تظهر بأي شاشة أو سجل.
model AttributionTouch {
  id              String   @id @default(cuid())
  workspaceId     String
  customerId      String
  conversationId  String
  channel         String
  kind            String
  source          String
  adId            String?
  adSourceType    String?
  ctwaClidEnc     String?
  refCode         String?
  codeStatus      String?
  codeProductCode String?
  codeCampaignRef String?
  codeWindowDays  Int?
  pageId          String?
  psidEnc         String?
  wabaId          String?
  messageId       String?
  episodeStart    Boolean  @default(false)
  dedupeKey       String   @unique
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conversationId, occurredAt])
  @@index([workspaceId, customerId, occurredAt])
  @@index([workspaceId, refCode])
}

/// اتصال سيستم 7 بنظام آخر بالمنظومة (الميديا باير · الكليبر · المالية ·
/// سيستم 1 · الأزمات · المهام · مساحة العمل · جسر Hermes). التوكن والسر
/// مشفّران (AES-256-GCM) ولا يرجعان لأي شاشة أو سجل.
model IntegrationConnection {
  id                    String    @id @default(cuid())
  workspaceId           String
  system                String
  baseUrl               String?
  tokenEncrypted        String?
  eventsUrl             String?
  eventsSecretEncrypted String?
  enabled               Boolean   @default(true)
  settings              Json      @default("{}")
  lastOkAt              DateTime?
  lastErrorAt           DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, system])
}

/// توكن نظام/وكيل يدخل على سيستم 7 (Bearer). يُحفظ تجزئته فقط، ويُعرض مرة
/// واحدة عند الإنشاء. صلاحيات مسماة بأقل حد · حد طلبات · سقف مسودات ·
/// صلاحية 90 يوم · زر إيقاف (revokedAt).
model IntegrationToken {
  id              String    @id @default(cuid())
  workspaceId     String
  system          String
  name            String
  tokenHash       String    @unique
  tokenPrefix     String
  scopes          String[]  @default([])
  rateLimitPerMin Int       @default(60)
  dailyDraftCap   Int       @default(20)
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, system])
}

/// صندوق الصادر الموحّد: كل حدث موقّع أو نداء لنظام آخر يُكتب هنا أولًا ثم
/// يرسله العامل بإعادة محاولة متزايدة — الحدث لا يضيع إذا النظام التاني واقف،
/// ولا يُرسل مرتين (dedupeKey + Idempotency-Key).
model IntegrationDelivery {
  id             String    @id @default(cuid())
  workspaceId    String
  system         String
  kind           String
  eventId        String?
  type           String
  method         String    @default("POST")
  url            String
  body           String
  idempotencyKey String?
  dedupeKey      String    @unique
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  responseCode   Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, system, createdAt])
}

/// مسودة من وكيل (Hermes) أو نظام: بطابور المراجعة ولا أثر لها قبل الاعتماد.
model AgentDraft {
  id             String    @id @default(cuid())
  workspaceId    String
  tokenId        String?
  source         String
  kind           String
  title          String
  payload        Json      @default("{}")
  status         String    @default("PENDING")
  idempotencyKey String?
  resultRef      String?
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([tokenId, createdAt])
}

/// سجل نداءات باب الوكلاء: مين · أي أداة · النتيجة · الوقت (بلا مدخلات حرة).
model AgentCallLog {
  id          String   @id @default(cuid())
  workspaceId String
  tokenId     String?
  tool        String
  risk        String
  status      String
  errorCode   String?
  requestId   String?
  agentRef    String?
  dryRun      Boolean  @default(false)
  latencyMs   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([tokenId, createdAt])
}

/// نسخة قواعد الادعاءات من سيستم 1 لكل منتج — مصدرها سيستم 1 فقط،
/// وتُعاد قراءتها مع compliance.updated وقبل أي استخدام إذا قديمة.
model ProductCompliance {
  id              String    @id @default(cuid())
  workspaceId     String
  productId       String    @unique
  productRef      String
  classification  String?
  verdict         String?
  allowedClaims   String[]  @default([])
  bannedClaims    String[]  @default([])
  adRules         String[]  @default([])
  sourceUpdatedAt DateTime?
  fetchedAt       DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
